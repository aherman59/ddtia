# --- LLM ---
# Fournisseur : albert ou mistral.
# Par défaut : albert si ALBERT_API_KEY est définie, sinon mistral.
# LLM_PROVIDER=albert

# Albert API (https://albert.api.etalab.gouv.fr)
ALBERT_API_KEY=<tata>
# Modèle Albert : identifiant ou alias listé par /v1/models (doit gérer l'appel d'outils).
# Défaut : openweight-code. Autres alias : openweight-large, openweight-medium, openweight-small
# ALBERT_MODEL=openweight-code
# ALBERT_BASE_URL=https://albert.api.etalab.gouv.fr/v1

# Mistral (si LLM_PROVIDER=mistral)
# MISTRAL_API_KEY=<toto>
# MISTRAL_MODEL=codestral-latest

# --- Mémoire vectorielle ChromaDB (données d'entraînement) ---
CHROMA_DIR=/home/onyxia/work/chroma
# CHROMA_COLLECTION=ddtia

# --- PostgreSQL ---
# Sur le Datalab (Onyxia / SSP Cloud), ces variables sont déjà définies dans
# l'environnement du service : ne les renseigner qu'en dehors du Datalab.
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=defaultdb
# PGUSER=<user>
# PGPASSWORD=<password>

# --- Divers (optionnel) ---
# Dossier de travail de l'agent (résultats CSV temporaires) ; défaut : dossier temporaire système
# DDTIA_WORK_DIR=/tmp/ddtia
